    animations {
        // A little spring, no snap; at niri's own pace (1.2 stretched every animation by a
        // fifth: a workspace switch 276 ms instead of 230)
        slowdown 1.0

        workspace-switch {
            duration-ms 200
            curve "cubic-bezier" 0.3 0 0.15 1
        }
        window-open {
            // angelOS open: default ×1.05
            duration-ms 267
            curve "ease-out-cubic"
        }
        window-close {
            // angelOS close: default
            duration-ms 220
            curve "ease-out-quad"
        }
        horizontal-view-movement {
            spring damping-ratio=0.85 stiffness=600 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=0.88 stiffness=620 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=0.7 stiffness=800 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 260
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=0.84 stiffness=620 epsilon=0.0001
        }
    }
