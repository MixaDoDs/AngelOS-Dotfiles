    animations {
        // A little spring, no snap; at niri's own pace (1.2 stretched every animation by a
        // fifth: a workspace switch 276 ms instead of 230)
        slowdown 1.0

        workspace-switch {
            duration-ms 224
            curve "cubic-bezier" 0.3 0 0.15 1
        }
        window-open {
            // angelOS open: dither
            duration-ms 180
            curve "linear"
            custom-shader r#"
                // angelOS open: the window appears pixel by pixel through an ordered (Bayer) dither, the grid of
                // 4 px "pixels" filling in evenly; each one lights up in the theme's accent for a moment.
                float angelos_bayer2(vec2 c) {
                    vec2 d = mod(c, 2.0);
                    return 2.0 * d.x + 3.0 * d.y - 4.0 * d.x * d.y;
                }

                // 8×8 Bayer matrix, 0..63: 64 even steps
                float angelos_bayer(vec2 c) {
                    return 16.0 * angelos_bayer2(c) + 4.0 * angelos_bayer2(floor(c / 2.0)) + angelos_bayer2(floor(c / 4.0));
                }

                vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                    if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0)
                        return vec4(0.0);
                    float p = niri_clamped_progress;
                    vec2 cell = floor(coords_geo.xy * size_geo.xy / 4.0);
                    float t = (angelos_bayer(cell) + 0.5) / 64.0 * 0.85;
                    if (p < t)
                        return vec4(0.0);
                    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * coords_geo).st);
                    float fresh = 1.0 - clamp((p - t) / 0.1, 0.0, 1.0);
                    color.rgb = mix(color.rgb, vec3(0.529, 0.690, 0.702) * color.a, fresh * 0.7);
                    return color;
                }
            "#
        }
        window-close {
            // angelOS close: dither
            duration-ms 160
            curve "linear"
            custom-shader r#"
                // angelOS close: the window dissolves pixel by pixel through an ordered (Bayer) dither — 4 px
                // "pixels" go out evenly over the whole window, none of it blurred.
                float angelos_bayer2(vec2 c) {
                    vec2 d = mod(c, 2.0);
                    return 2.0 * d.x + 3.0 * d.y - 4.0 * d.x * d.y;
                }

                // 8×8 Bayer matrix, 0..63: 64 even steps
                float angelos_bayer(vec2 c) {
                    return 16.0 * angelos_bayer2(c) + 4.0 * angelos_bayer2(floor(c / 2.0)) + angelos_bayer2(floor(c / 4.0));
                }

                vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                    if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0)
                        return vec4(0.0);
                    float p = niri_clamped_progress;
                    vec2 cell = floor(coords_geo.xy * size_geo.xy / 4.0);
                    float t = (angelos_bayer(cell) + 0.5) / 64.0 * 0.9;
                    if (p > t)
                        return vec4(0.0);
                    // the pixels left keep the window's own colours, a touch dimmer as it goes
                    vec2 sample_geo = (cell + 0.5) * 4.0 / size_geo.xy;
                    vec4 color = texture2D(niri_tex, (niri_geo_to_tex * vec3(sample_geo, 1.0)).st);
                    return color * (1.0 - 0.3 * p);
                }
            "#
        }
        horizontal-view-movement {
            spring damping-ratio=0.85 stiffness=600 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=0.88 stiffness=620 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=0.9 stiffness=700 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=0.7 stiffness=800 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 260
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=0.84 stiffness=620 epsilon=0.0001
        }
    }
