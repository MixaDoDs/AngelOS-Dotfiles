// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
    keyboard {
        xkb {
            // Generated by install.sh (it asks which layouts and which
            // shortcut you want). Edit by hand at any time; Niri reloads live.
            //   layouts:   comma separated XKB codes, e.g. "us,ru" or "us,de,ua"
            //   options:   "grp:alt_shift_toggle", "grp:ctrl_shift_toggle",
            //              "grp:caps_toggle", "grp:ralt_toggle", ...
            // Check what is active with: niri msg keyboard-layouts
            layout "@KB_LAYOUT@"
            options "@KB_OPTIONS@"
        }
        repeat-delay 250
        repeat-rate 45
        numlock
    }

    touchpad {
        tap // Enable tap-to-click
        natural-scroll // Enable natural (macOS-style) scrolling
        drag-lock // Lift the finger mid-drag and put it back: the drag goes on (#93)
    }

    // Pointer speed and acceleration are intentionally NOT set: every mouse is
    // different, so the libinput defaults apply. To tune yours, add e.g.
    //
    //   mouse {
    //       accel-profile "adaptive"   // or "flat" for raw 1:1 movement
    //       accel-speed 0.4            // -1.0 (slowest) … 1.0 (fastest)
    //   }

    focus-follows-mouse // Automatically focus windows under the mouse pointer
    workspace-auto-back-and-forth // Enable workspace back & forth switching
}
