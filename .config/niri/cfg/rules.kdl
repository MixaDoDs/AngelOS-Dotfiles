
window-rule {
    match app-id="steam" title="^$"
    open-floating true
    min-width 1
    min-height 1
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Telegram's photo/video viewer floats; the chat window stays tiled.
window-rule {
    match app-id=r#"^org\.telegram\.desktop$"# title="^Media viewer$"
    open-floating true
}

// Square window and popup geometry matches angelOS pixel decorations.
window-rule {
    exclude app-id="^liquid-glass-test$"
    exclude app-id="^org.quickshell$" title="^angelOS"
    opacity 1.0
    geometry-corner-radius 0
    clip-to-geometry true

    // blur/saturation off — with focus-follows-mouse the glass effect
    // looked like an inner glow on hover/focus.
    background-effect {
        blur false
        xray false
    }

    popups {
        opacity 1.0
        geometry-corner-radius 0
        background-effect {
            blur false
            xray false
        }
    }
}

// Inactive opacity dimming removed — with focus-follows-mouse it made
// windows "shine" on hover (0.90 → 0.94). Keep uniform opacity.

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Liquid glass shader test window (LiquidIslandQS port, GLFW harness).
    window-rule {
        match app-id="^liquid-glass-test$"
        open-floating true
        default-floating-position x=0 y=0
        // Cover the whole working area; the input region keeps it click-through.
        default-column-width { proportion 1.0; }
        default-window-height { proportion 1.0; }
        opacity 1.0
        geometry-corner-radius 0
        // The client supplies the exact silhouette through ext-background-effect.
        // Keep only xray=false here so niri never falls back to full-window blur
        // while the first region or a monitor move is being committed.
        background-effect {
            xray false
        }
        focus-ring { off; }
        border { off; }
        shadow { off; }
    }

    // (a named "privacy" workspace used to be declared here: niri keeps named
    // workspaces forever at the top of a monitor, the panel hid it and the
    // desk numbers slipped — angelOS issue #17)
    window-rule {
        match title="niri-cast-privacy"
        match app-id="dev.niri.cast-privacy"
        open-focused false
        open-floating true
    }

    // Photoshop (Wine via xwayland-satellite): no rounded clip so the canvas
    // isn't cut, main window tiled full width instead of floating.
    window-rule {
        match app-id=r#"(?i)photoshop"#
        match title=r#"^Adobe Photoshop"#
        geometry-corner-radius 0
        clip-to-geometry false
    }
    window-rule {
        match title=r#"^Adobe Photoshop 20\d\d$"#
        open-floating false
        default-column-width { proportion 1.0; }
    }

    // ─── angelOS (managed by angelos switch.py) ───
    layer-rule {
        match namespace="^angelos-wallpaper$"
        place-within-backdrop true
    }
    layer-rule {
        match namespace="^angelos-"
        background-effect {
            xray false
        }
    }
    window-rule {
        match app-id="^org.quickshell$" title="^angelOS"
        open-floating true
        geometry-corner-radius 0
        clip-to-geometry false
        border { off; }
        focus-ring { off; }
        shadow { off; }
        default-column-width { fixed 1040; }
        default-window-height { fixed 740; }
    }
    // angelOS dev instances (ANGELOS_DEV=1): keep test windows off the stream monitor
    window-rule {
        match app-id="^org.quickshell$" title=r#"^angelOS \[dev\]"#
        open-on-output "HDMI-A-1"
        open-focused false
        block-out-from "screencast"
    }
    // ─── /angelOS ───
