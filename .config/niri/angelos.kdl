// angelOS Golden Gate / dark — generated by angelOS, do not edit (templates/niri-mac.kdl)
// The Golden Gate skin: windows like macOS 27's — one corner radius for all, no coloured frame,
// a soft shadow that is deeper under the active window. Back to templates/niri.kdl when the
// skin is off or the demon rules.
layout {
    focus-ring {
        off
    }
    border {
        off
    }
    shadow {
        on
        softness 42
        spread 1
        offset x=0 y=14
        draw-behind-window true
        color "#00000070"
        inactive-color "#00000030"
    }
    tab-indicator {
        active-color   "#ff9f0a"
        inactive-color "#ffffff24"
        urgent-color   "#ff3b30"
    }
    insert-hint {
        color "#ff9f0a66"
    }
}

recent-windows {
    highlight {
        active-color "#ff9f0a"
        urgent-color "#ff3b30"
    }
}

overview {
    backdrop-color "#101012"
    workspace-shadow {
        softness 50
        spread 4
        offset x=0 y=16
        color "#00000055"
    }
}

// a Mac has no hot corners unless asked for — and the emblem's menu sits in the top-left one
gestures {
    hot-corners {
        off
    }
}

// one corner for every window, 16 px, like Golden Gate's; Photoshop's canvas isn't cut
window-rule {
    exclude app-id=r#"(?i)photoshop"#
    exclude title=r#"^Adobe Photoshop"#
    geometry-corner-radius 16
    clip-to-geometry true
}
// angelOS's own windows (System Settings…) are Mac windows too here
window-rule {
    match app-id="^org.quickshell$" title="^angelOS"
    geometry-corner-radius 16
    clip-to-geometry true
    shadow {
        on
    }
}
window-rule {
    open-floating true
}
window-rule {
    match is-floating=true
    exclude app-id=r#"^firefox$"#
    exclude app-id=r#"^zen$"#
    exclude app-id=r#"^librewolf$"#
    exclude app-id=r#"^chromium$"#
    exclude app-id=r#"^google-chrome$"#
    exclude app-id=r#"^brave-browser$"#
    exclude app-id=r#"^org\.gnome\."#
    exclude app-id=r#"^io\.missioncenter\."#
    exclude app-id=r#"^org\.pipewire\.Helvum$"#
    exclude app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    exclude app-id=r#"^com\.shellyorg\.shelly$"#
    exclude app-id=r#"^localsend"#
    exclude app-id=r#"^com\.mitchellh\.ghostty$"#
    exclude app-id=r#"^org\.quickshell$"#
    exclude app-id=r#"^quickshell$"#
    exclude app-id=r#"^steam$"#
    exclude app-id=r#"^discord$"#
    exclude app-id=r#"^vesktop$"#
    exclude app-id=r#"^spotify$"#
    exclude app-id=r#"^code$"#
    exclude app-id=r#"^code-oss$"#
    exclude app-id=r#"^cursor$"#
    exclude app-id=r#"^obsidian$"#
    exclude app-id=r#"^org\.telegram\.desktop$"#
    geometry-corner-radius 0 0 16 16
}

binds {
    Mod+Q hotkey-overlay-title="Golden Gate: quit the app" { spawn-sh "qs -c angelos ipc call angelos macQuit"; }
    Mod+W hotkey-overlay-title="Golden Gate: close the window" { close-window; }
    Mod+M hotkey-overlay-title="Golden Gate: minimize the window" { spawn-sh "qs -c angelos ipc call angelos macMinimize"; }
    Mod+Space hotkey-overlay-title="Golden Gate: Spotlight" { spawn-sh "qs -c angelos ipc call angelos startMenu ''"; }
    Mod+Comma hotkey-overlay-title="Golden Gate: System Settings" { spawn-sh "qs -c angelos ipc call angelos settings ''"; }
    Ctrl+Up hotkey-overlay-title="Golden Gate: Mission Control" { toggle-overview; }
    F3 { toggle-overview; }
    Mod+Shift+3 hotkey-overlay-title="Golden Gate: screenshot of the screen" { screenshot-screen; }
    Mod+Shift+4 hotkey-overlay-title="Golden Gate: screenshot of a part" { screenshot; }
    Mod+Shift+5 { screenshot-window; }
    Mod+Ctrl+Q hotkey-overlay-title="Golden Gate: lock the screen" { spawn-sh "qs -c angelos ipc call angelos lock"; }
    Mod+Ctrl+F hotkey-overlay-title="Golden Gate: full screen" { fullscreen-window; }
    Mod+Alt+Escape hotkey-overlay-title="Golden Gate: force quit" { spawn-sh "qs -c angelos ipc call angelos macMenu 0"; }
    Ctrl+F2 hotkey-overlay-title="Golden Gate: the menu bar" { spawn-sh "qs -c angelos ipc call angelos macMenu -1"; }
}

