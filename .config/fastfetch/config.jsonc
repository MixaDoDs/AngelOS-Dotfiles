// angelOS fastfetch style: window
// Written by angelOS (Settings → System → fastfetch). Pick "own" there and this file
// is yours again (the one you had first is config.before-angelos.jsonc).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "@HOME@/.config/fastfetch/angelos-logo.txt",
    "width": 38,
    "height": 13,
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;135;176;179",
      "title": "38;2;175;202;204",
      "separator": "38;2;180;181;183"
    },
    "size": {
      "ndigits": 1
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;135;176;179}╭─{#} {#1;38;2;175;202;204}♡ AngelOS.sh{#} {#38;2;135;176;179}─────────────── ─ □ ✕{#}"
    },
    {
      "type": "title",
      "format": "{#38;2;135;176;179}│{#} {#1;38;2;175;202;204}{user-name}{#}@{host-name}"
    },
    {
      "type": "os",
      "key": "│ os",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "│ kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "│ uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "packages",
      "key": "│ pkgs",
      "format": "{all}"
    },
    {
      "type": "cpu",
      "key": "│ cpu",
      "format": "{name:24}"
    },
    {
      "type": "gpu",
      "key": "│ gpu",
      "format": "{name:24}"
    },
    {
      "type": "memory",
      "key": "│ ram",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "│ disk",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 0"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 1"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 2"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 3"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 4"
    },
    {
      "type": "command",
      "key": " ",
      "text": "python3 @HOME@/.config/quickshell/angelos/scripts/gear.py --fmt '{#38;2;135;176;179}│ {#}{#1;38;2;135;176;179}{word:7}{#}{name}  {#1;38;2;223;210;126}{price}' --lang ru --nth 5"
    },
    {
      "type": "custom",
      "format": "{#38;2;135;176;179}╰────────────────────{#}  {#38;2;135;176;179}♥ {#38;2;175;202;204}♥ {#38;2;223;210;126}♥ {#38;2;177;204;206}♥ {#38;2;203;221;222}♥{#}"
    }
  ]
}
