dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.astro/
.vite/
.turbo/
.parcel-cache/
.cache/
storybook-static/
# Browser extension packaged output
extension/dist/
web-ext-artifacts/
*.xpi
*.crx
*.pem
# Framework / tooling caches
.eslintcache
.stylelintcache
*.tsbuildinfo
.vercel/
.netlify/

# ------------------------------------------------------------------------------
