# ==============================================================================
# Miabeyefendi - Universal .gitignore Template
# https://github.com/Miabeyefendi
# Comments are kept in English on purpose: this is the universal convention for
# shared dotfiles. Trim sections you do not use; ignoring a few extra patterns
# is harmless, but never delete the "Environment & Secrets" block.
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating system cruft
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon

# Linux
*~
.directory
.Trash-*
.nfs*

# ------------------------------------------------------------------------------
# Compiled binaries / shared libraries (top level, language-agnostic)
# ------------------------------------------------------------------------------
# UYARI: Derlenmis uygulamasini repoda yayinliyorsan (or. SteamEdge) asagiya
# istisna ekle, yoksa surum dosyan sessizce commit edilmez:
#   !Release/SteamEdge.exe
#   !dist/*.dll
*.exe
*.dll
*.so
*.so.*
*.dylib

# ------------------------------------------------------------------------------
# Environment & secrets (CRITICAL - never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_dsa
secrets.json
credentials.json
client_secret*.json
service-account*.json
*.tfvars
!*.tfvars.example

# ------------------------------------------------------------------------------
# Credentials & user data (CRITICAL - account, login and session files)
# These are the files that leak a real person's account, not just an API key.
# ------------------------------------------------------------------------------
account.json
accounts.json
password.json
passwords.json
login.json
logins.json
user.json
users.json
profile.json
profiles.json
token.json
tokens.json
auth.json
authorization.json
cookie.json
cookies.json
cookies.txt
session.json
sessions.json
storage_state.json
config.local.json
settings.local.json
secrets.*
!secrets.example.*
*.session
*.sessions
*.cookies
*.token
*.credentials
.netrc
_netrc
.htpasswd

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
# Testing / coverage / type checking
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
# Notebooks
.ipynb_checkpoints/

