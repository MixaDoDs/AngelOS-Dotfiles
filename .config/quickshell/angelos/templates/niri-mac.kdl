// angelOS Golden Gate / {{mode}} — generated by angelOS, do not edit (templates/niri-mac.kdl)
// The Golden Gate skin: windows like macOS 27's — one corner radius for all, no coloured frame,
// a soft shadow that is deeper under the active window. Back to templates/niri.kdl when the
// skin is off or the demon rules.
// The apps draw their own title bars (client-side decorations, as on a Mac every window has its
// own): GTK's traffic lights on the left (gtk-live.py: button-layout close,minimize,maximize:),
// Qt's Adwaita frame with the same order, kitty's, the browsers'. niri draws none and angelOS
// none over them. This file comes after cfg/misc.kdl: its prefer-no-csd (the pixel skins') and
// QT_WAYLAND_DISABLE_WINDOWDECORATION are turned back here. The yellow light reaches angelOS
// through extras/minimize-hook (niri 26.04 drops xdg_toplevel.set_minimized).
prefer-no-csd false
environment {
    QT_WAYLAND_DISABLE_WINDOWDECORATION null
    QT_WAYLAND_DECORATION "adwaita"
}
layout {
    focus-ring {
        off
    }
    border {
        off
    }
    shadow {
        on
        softness 42
        spread 1
        offset x=0 y=14
        draw-behind-window true
        color "#00000070"
        inactive-color "#00000030"
    }
    tab-indicator {
        active-color   "{{macAccent}}"
        inactive-color "{{macLineHex}}"
        urgent-color   "#ff3b30"
    }
    insert-hint {
        color "{{macAccent}}66"
    }
}

recent-windows {
    highlight {
        active-color "{{macAccent}}"
        urgent-color "#ff3b30"
    }
}

overview {
    backdrop-color "{{macOverview}}"
    workspace-shadow {
        softness 50
        spread 4
        offset x=0 y=16
        color "#00000055"
    }
}

// a Mac has no hot corners unless asked for — and the emblem's menu sits in the top-left one
gestures {
    hot-corners {
        off
    }
}

// one corner for every window, 16 px, like Golden Gate's; Photoshop's canvas isn't cut
window-rule {
    exclude app-id=r#"(?i)photoshop"#
    exclude title=r#"^Adobe Photoshop"#
    geometry-corner-radius 16
    clip-to-geometry true
}
// angelOS's own windows (System Settings…) are Mac windows too here
window-rule {
    match app-id="^org.quickshell$" title="^angelOS"
    geometry-corner-radius 16
    clip-to-geometry true
    shadow {
        on
    }
}
{{macWindowRules}}
{{macBinds}}
