<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- angelOS: the battery charge limit (Settings → Battery). The active session may set it
     without a password; the helper takes nothing but a number 50…100. -->
<policyconfig>
  <vendor>angelOS</vendor>
  <action id="org.angelos.charge-limit">
    <description>Set the battery charge limit</description>
    <description xml:lang="ru">Установить лимит заряда батареи</description>
    <message>angelOS wants to set the battery charge limit</message>
    <message xml:lang="ru">angelOS хочет установить лимит заряда батареи</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/angelos-charge-limit</annotate>
  </action>
</policyconfig>
