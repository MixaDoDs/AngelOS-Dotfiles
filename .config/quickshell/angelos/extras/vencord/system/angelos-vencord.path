# a Flatpak update deploys a new folder and switches "active" to it: Discord is clean again
[Unit]
Description=angelOS: watch the Flatpak Discord for its updates

[Path]
PathChanged=/var/lib/flatpak/app/com.discordapp.Discord/x86_64/stable
Unit=angelos-vencord.service

[Install]
WantedBy=multi-user.target
