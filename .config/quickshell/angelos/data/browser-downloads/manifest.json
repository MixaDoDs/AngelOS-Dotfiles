{
  "manifest_version": 3,
  "name": "angelOS downloads",
  "version": "1.0",
  "description": "Tells angelOS's Halo how far your downloads are (sizes only, no addresses). Installed by angelOS; scripts/browser-downloads.py remove takes it out.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "bg.js",
    "scripts": [
      "bg.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "downloads@angelos",
      "strict_min_version": "121.0"
    }
  }
}
