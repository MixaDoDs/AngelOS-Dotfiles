{
  "_comment": [
    "Menus for apps that give the Golden Gate menu bar nothing of their own (services/AppMenu.qml).",
    "Every item does something real: \"keys\" presses the app's own shortcut in the focused window",
    "(wtype), \"seq\" runs steps one after another (keys, or text typed into a field the step before",
    "opened), \"run\" starts a command. Shortcuts are the apps' stock ones; tests/appmenu/test_profiles.py",
    "checks that no item lacks an action. \"$edit\" and \"$termedit\" are the shared Edit menus.",
    "Labels: [Russian, English]."
  ],
  "match": {
    "firefox": ["firefox", "firefox-esr", "librewolf", "zen", "floorp", "waterfox", "org.mozilla.firefox"],
    "chromium": ["chromium", "google-chrome", "helium", "brave-browser", "vivaldi-stable", "vivaldi", "microsoft-edge", "thorium-browser", "net.imput.helium"],
    "kitty": ["kitty"],
    "alacritty": ["Alacritty", "alacritty"],
    "foot": ["foot", "footclient"],
    "nautilus": ["org.gnome.Nautilus"],
    "steam": ["steam"],
    "obsidian": ["obsidian", "md.obsidian.Obsidian"],
    "discord": ["discord", "vesktop", "com.discordapp.Discord", "dev.vencord.Vesktop"],
    "code": ["code", "code-oss", "Code", "cursor", "codium", "vscodium"],
    "electron": ["electron", "slack", "signal", "element", "spotify", "chatgpt", "claude", "claude-desktop"],
    "gtk": []
  },
