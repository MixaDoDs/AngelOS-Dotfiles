    "$edit": {
      "title": ["Правка", "Edit"],
      "items": [
        {"label": ["Отменить", "Undo"], "keys": ["ctrl", "z"]},
        {"label": ["Повторить", "Redo"], "keys": ["ctrl", "shift", "z"]},
        "-",
        {"label": ["Вырезать", "Cut"], "keys": ["ctrl", "x"]},
        {"label": ["Копировать", "Copy"], "keys": ["ctrl", "c"]},
        {"label": ["Вставить", "Paste"], "keys": ["ctrl", "v"]},
        {"label": ["Выбрать все", "Select All"], "keys": ["ctrl", "a"]}
      ]
    },
    "$termedit": {
      "title": ["Правка", "Edit"],
      "items": [
        {"label": ["Копировать", "Copy"], "keys": ["ctrl", "shift", "c"]},
        {"label": ["Вставить", "Paste"], "keys": ["ctrl", "shift", "v"]}
      ]
    }
  },
