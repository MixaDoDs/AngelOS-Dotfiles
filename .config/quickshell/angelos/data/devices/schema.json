{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "angelOS device description",
  "description": "One device of the devices' driver (docs/devices.md). `angelos devices check FILE` is the checker the shell itself uses; this schema is the same rules for editors.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "kind",
    "family",
    "usb",
    "channel",
    "support",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "maker": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "mouse"
      ]
    },
    "family": {
      "enum": [
        "lamzu-aurora"
      ]
    },
    "usb": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "vid",
          "pid"
        ],
        "properties": {
          "vid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{4}$"
          },
          "pid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{4}$"
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "required": [
        "via"
      ],
      "properties": {
        "via": {
          "enum": [
            "hidraw"
          ]
        }
      }
    },
    "support": {
      "enum": [
        "verified",
        "described",
        "readonly"
      ]
    },
    "checked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The capabilities checked on real hardware."
    },
    "firmware": {
      "type": "object"
    },
    "notes": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pollingRate": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        "dpi": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "min",
                "max",
                "step",
                "stages"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                },
                "stages": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "lod": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        "debounce": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "motionSync": {
          "type": [
            "boolean",
            "object"
          ]
        },
        "sleep": {
          "anyOf": [
            {
              "const": false
            },
            {
              "type": "object",
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          ]
        },
        "battery": {
          "type": [
            "boolean",
            "object"
          ]
        },
        "angleSnap": {
          "type": [
            "boolean",
            "object"
          ]
        },
        "rippleControl": {
          "type": [
            "boolean",
            "object"
          ]
        }
      }
    }
  }
}
