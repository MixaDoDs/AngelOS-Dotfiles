# The live image's packages, before install.sh adds angelOS's own (packages/*.txt). Replaces releng's
# rescue set: the installed system is a copy of this image, so only what a desktop and the installer need.

# boot (mkarchiso needs mkinitcpio-archiso and syslinux; systemd-boot comes with systemd)
base
linux
linux-firmware
amd-ucode
intel-ucode
sof-firmware
mkinitcpio
mkinitcpio-archiso
syslinux
efibootmgr

# disks — the installer's backend (milestone 3) and archinstall for manual partitioning
arch-install-scripts
archinstall
squashfs-tools
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
gptfdisk
parted
cryptsetup
rsync

# network
networkmanager
wireless-regdb
bluez
bluez-utils

# the live desktop: just enough angelOS to run the installer. The installed system gets the whole
# packages/*.txt from install.sh over the network (05.11: install over the network, the image ≤ 2 GiB)
niri
quickshell
qt6-declarative
qt6-5compat
qt6-imageformats
qt6-multimedia
qt6-multimedia-ffmpeg
qt6-svg
sddm
mesa
vulkan-radeon
vulkan-intel
vulkan-nouveau
pipewire
pipewire-pulse
wireplumber
xdg-desktop-portal-gtk
xdg-user-dirs
xsettingsd
librsvg
python
python-gobject
jq
socat
curl
wl-clipboard
libnotify
playerctl
brightnessctl
upower
fontconfig
ttf-dejavu
noto-fonts-emoji
capitaine-cursors
foot

# install.sh and the tests
sudo
git
openssh
grim
qemu-guest-agent
nano
less
usbutils
pciutils
