#!/usr/bin/env python3
"""Disable niri animations and compositor effects while a window covers an output.

angelOS's Settings → Appearance → Motion "off" (settings.json appearance.motion) keeps niri's
animations off all the time, effects untouched; angelOS runs this once when it changes. A
laptop's eco mode ($XDG_RUNTIME_DIR/angelos/eco, services/Power) turns the blur off too.

While the covering window is a game (--watch only), also boost: the "performance" power
profile (no password: power-profiles-daemon allows the active session; sched-ext is left
alone, scx_loader asks for one) and $XDG_RUNTIME_DIR/niri-game-mode/game for anyone who
should step aside (the stream bot unloads its whisper from the video card). niri itself goes
up to nice -11 (the user's own limit: no password) and voice typing (voxtype.service) stops;
$XDG_RUNTIME_DIR/niri-game-mode/state says "game" for angelOS, which pauses what only
animates on the other screens. A game counts while it covers its output or has the focus
(CS2 in a 4:3 borderless window covers nothing). All of it goes back to what it was when the
game leaves or this exits. Such a 4:3 window is stretched over the screen too (STRETCH_GAMES).

angelOS's "esports" power profile ($XDG_RUNTIME_DIR/angelos/esports) counts as a game all the
time. While boosted, Discord, Helium and Spotify step below the game (Chromium raises its own
threads to nice -8 when the limit allows it), back to what they were after. A run without
--watch (angelOS makes one when the eco or esports flag changes) wakes the watching one.

Always (Settings → System → Power → "The window in focus first"): the focused window's process
and its children run FOCUS_BOOST nice steps above where they were, back when the focus leaves."""
from __future__ import annotations

import json
import os
import re
import resource
import select
import signal
import subprocess
import sys
import time
from pathlib import Path

CFG = Path.home() / ".config/niri/cfg/game-mode.kdl"
SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "angelos/settings.json"
RUN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "niri-game-mode"
GAME_FLAG = RUN_DIR / "game"
BOOST_SAVED = RUN_DIR / "boost.json"
STATE_FILE = RUN_DIR / "state"
WATCH_PID = RUN_DIR / "watch.pid"
NIRI_NICE = -11
# below the game's 0, not so low that a voice call stutters
BACKGROUND = ("Discord", "helium", "spotify")
BACKGROUND_NICE = 5
# the focused window's processes, this many nice steps up (not past the user's limit)
FOCUS_BOOST = 3
# games that draw into a corner of their window (a 4:3 borderless CS2): stretched by angel-satellite
# through this helper, one per game while its window is open (its GAMES names the same)
STRETCH = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "quickshell/angelos/scripts/game-stretch.py"
STRETCH_GAMES = ("cs2",)

ON = """\
// auto-generated by niri-game-mode — fullscreen: effects off
animations {
    off
}

window-rule {
    opacity 1.0
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry false
}

window-rule {
    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^angelos-"
    background-effect {
        blur false
        xray false
    }
}
"""

OFF = """\
// auto-generated by niri-game-mode — inactive
"""

STILL = """\
// auto-generated by niri-game-mode — angelOS motion off: no animations
animations {
    off
}
"""


ECO = """\
// auto-generated by niri-game-mode — angelOS eco mode: no animations, no blur
animations {
    off
}

window-rule {
    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^angelos-"
    background-effect {
        blur false
        xray false
    }
}
"""

ECO_FLAG = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "angelos/eco"
ESPORTS_FLAG = ECO_FLAG.with_name("esports")


def eco() -> bool:
    """a laptop's eco mode is on (angelOS keeps the flag while it lasts)"""
    return ECO_FLAG.exists()


def esports() -> bool:
    """angelOS's esports power profile: a game all the time"""
    return ESPORTS_FLAG.exists()


def still() -> bool:
    """angelOS's motion setting is "off" (no animations, an optimisation mode)"""
    try:
        return (json.loads(SETTINGS.read_text()).get("appearance") or {}).get("motion") == "off"
    except (OSError, ValueError, AttributeError):
        return False

# A new state must hold this long before the config is reloaded, so a window
# passing through output size (launch, fullscreen toggle, alt-tab) costs one
# reload instead of a burst of them.
ON_DELAY = 0.3
OFF_DELAY = 0.6
# the boost outlasts an alt-tab: putting it back restarts voice typing and resets the mouse
GAME_OFF_DELAY = 10.0
SIZE_SLACK = 2


def niri_json(*args):
    raw = subprocess.check_output(["niri", "msg", "--json", *args], stderr=subprocess.DEVNULL)
    return json.loads(raw)


def output_sizes() -> dict[str, tuple[int, int]]:
    try:
        outputs = niri_json("outputs") or {}
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        return {}
    sizes = {}
    for name, o in outputs.items():
        logical = o.get("logical") or {}
        try:
            sizes[name] = (int(logical["width"]), int(logical["height"]))
        except (KeyError, TypeError, ValueError):
            continue
    return sizes


class State:
    """Windows and workspaces, kept current from niri's event stream."""

    def __init__(self) -> None:
        self.sizes = output_sizes()
        self.workspaces: dict[int, dict] | None = None
        self.windows: dict[int, dict] | None = None

    @property
    def ready(self) -> bool:
        return self.workspaces is not None and self.windows is not None

    def feed(self, line: bytes) -> None:
        try:
            ev = json.loads(line)
            if isinstance(ev, dict) and len(ev) == 1:
                (key, body), = ev.items()
                self.handle(key, body)
        except (json.JSONDecodeError, KeyError, TypeError, ValueError, AttributeError):
            pass

    def handle(self, key: str, body: dict) -> None:
        if key == "WorkspacesChanged":
            self.workspaces = {ws["id"]: ws for ws in body["workspaces"]}
            # A new output (hotplug) shows up here first.
            if any(ws.get("output") and ws["output"] not in self.sizes
                   for ws in self.workspaces.values()):
                self.sizes = output_sizes()
        elif key == "WorkspaceActivated" and self.workspaces is not None:
            ws = self.workspaces.get(body["id"])
            if ws is not None:
                for other in self.workspaces.values():
                    if other.get("output") == ws.get("output"):
                        other["is_active"] = False
                ws["is_active"] = True
        elif key == "WindowsChanged":
            self.windows = {w["id"]: w for w in body["windows"]}
        elif key == "WindowOpenedOrChanged" and self.windows is not None:
            self.windows[body["window"]["id"]] = body["window"]
        elif key == "WindowFocusChanged" and self.windows is not None:
            for wid, win in self.windows.items():
                win["is_focused"] = wid == body.get("id")
        elif key == "WindowClosed" and self.windows is not None:
            self.windows.pop(body["id"], None)
        elif key == "WindowLayoutsChanged" and self.windows is not None:
            for wid, layout in body["changes"]:
                if wid in self.windows:
                    self.windows[wid]["layout"] = layout
        elif key == "ConfigLoaded":
            # Mode, scale or transform may have changed.
            self.sizes = output_sizes()

    def load_snapshot(self) -> None:
        self.handle("WorkspacesChanged", {"workspaces": niri_json("workspaces") or []})
        self.handle("WindowsChanged", {"windows": niri_json("windows") or []})

    def covering(self) -> tuple[dict, str | None] | None:
        """Return (window, output) for a window that covers its output, if any."""
        return next(self.coverers(), None)

    def game(self) -> tuple[dict, str | None] | None:
        """Return (window, output) for a game that covers its output or has the focus, if any."""
        hit = next((hit for hit in self.coverers() if is_game(hit[0])), None)
        if hit or not self.ready:
            return hit
        win = next((w for w in self.windows.values() if w.get("is_focused")), None)
        if win is None or not is_game(win):
            return None
        out = next((ws.get("output") for ws in self.workspaces.values() if ws["id"] == win.get("workspace_id")), None)
        return win, out

    def coverers(self):
        if not self.ready:
            return
        active = {ws["id"]: ws.get("output")
                  for ws in self.workspaces.values() if ws.get("is_active")}
        for win in self.windows.values():
            wid = win.get("workspace_id")
            if wid not in active:
                continue
            size = (win.get("layout") or {}).get("window_size") or [0, 0]
            try:
                ww, hh = int(size[0]), int(size[1])
            except (TypeError, ValueError, IndexError):
                continue
            oname = active[wid]
            candidates = [self.sizes[oname]] if oname in self.sizes else list(self.sizes.values())
            for ow, oh in candidates:
                if abs(ww - ow) <= SIZE_SLACK and abs(hh - oh) <= SIZE_SLACK:
                    yield win, oname
                    break


def _environ(pid: int) -> bytes:
    try:
        return Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return b""


def _comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def steam_game_running() -> bool:
    """Steam's reaper (`reaper SteamLaunch AppId=… -- game`) lives as long as the game."""
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if b"SteamLaunch" in (d / "cmdline").read_bytes():
                    return True
            except OSError:
                pass
    return False


def is_game(win: dict) -> bool:
    """Proton games show up as steam_app_<id>; native ones carry Steam's SteamGameId; X11 ones
    reach niri through xwayland-satellite, so for those a running Steam game has to do."""
    app_id = win.get("app_id") or ""
    if app_id.startswith("steam_app_") or app_id == "gamescope":
        return True
    pid = win.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return False
    env = _environ(pid)
    if re.search(rb"(?:^|\0)Steam(?:Game|App)Id=[1-9]", env):
        return True
    return _comm(pid).lower().startswith(("xwayland", "xwayland-satellite")) and steam_game_running()


def _run(*cmd: str) -> str | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10, check=True).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None


def niri_threads() -> list[int]:
    """niri's threads (a nice is per thread on Linux), of this user's niri"""
    for d in Path("/proc").iterdir():
        if d.name.isdigit() and _comm(int(d.name)) == "niri":
            try:
                if d.stat().st_uid == os.getuid():
                    return [int(t.name) for t in (d / "task").iterdir()]
            except OSError:
                pass
    return []


def renice_niri(nice: int) -> int | None:
    """Set niri's nice; the one it had (None: no niri, or not allowed)."""
    tids = niri_threads()
    if not tids:
        return None
    try:
        before = os.getpriority(os.PRIO_PROCESS, tids[0])
        for tid in tids:
            try:
                os.setpriority(os.PRIO_PROCESS, tid, nice)
            except ProcessLookupError:
                pass
        return before
    except OSError:
        return None


def background_threads() -> list[int]:
    """the threads of this user's Discord, Helium and Spotify"""
    tids = []
    for d in Path("/proc").iterdir():
        if d.name.isdigit() and _comm(int(d.name)) in BACKGROUND:
            try:
                if d.stat().st_uid == os.getuid():
                    tids += [int(t.name) for t in (d / "task").iterdir()]
            except OSError:
                pass
    return tids


def lower_background(saved: dict[str, int]) -> None:
    """Put the background apps at BACKGROUND_NICE; `saved` gets each thread's nice from before
    (the first time it is seen)."""
    for tid in background_threads():
        try:
            saved.setdefault(str(tid), os.getpriority(os.PRIO_PROCESS, tid))
            os.setpriority(os.PRIO_PROCESS, tid, BACKGROUND_NICE)
        except OSError:
            pass


def restore_background(saved: dict[str, int]) -> None:
    """Give the threads their nice back; one started meanwhile goes to 0."""
    for tid in background_threads():
        try:
            if os.getpriority(os.PRIO_PROCESS, tid) == BACKGROUND_NICE:
                os.setpriority(os.PRIO_PROCESS, tid, saved.get(str(tid), 0))
        except OSError:
            pass


def background_fps_wanted() -> int:
    """angelOS's Settings → System → Games: the other screens' frame rate in a game (0 = as is)"""
    try:
        fps = (json.loads(SETTINGS.read_text()).get("gaming") or {}).get("backgroundFps", 30)
        return max(0, int(fps))
    except (OSError, ValueError, TypeError, AttributeError):
        return 30


def background_fps(fps: int, output: str | None = None) -> None:
    """angel-niri draws the screens without the game at most `fps` times a second — never the
    game's `output`, nor a screen a stream or recording shows (stock niri doesn't know the action:
    nothing happens)"""
    _run("niri", "msg", "action", "set-background-fps", str(fps), *(["--output", output] if output else []))


def tearing_wanted() -> bool:
    """angelOS's Settings → System → Games: a fullscreen game's frames may tear for less lag"""
    try:
        return (json.loads(SETTINGS.read_text()).get("gaming") or {}).get("tearing", True) is not False
    except (OSError, ValueError, AttributeError):
        return True


def tearing(on: bool, output: str | None = None) -> None:
    """angel-niri shows a fullscreen game's frames at once instead of at the next vblank (stock
    niri doesn't know the action: nothing happens)"""
    _run("niri", "msg", "action", "set-tearing", "--on", "true" if on else "false",
         *(["--output", output] if output else []))


GPU_CLOCKS = "/usr/local/lib/angelos/gpu-clocks"


def gpu_clocks_wanted() -> bool:
    """angelOS's Settings → System → Games: the NVIDIA card at full speed while a game runs"""
    try:
        return (json.loads(SETTINGS.read_text()).get("gaming") or {}).get("gpuClocks", True) is not False
    except (OSError, ValueError, AttributeError):
        return True


def gpu_clocks(on: bool) -> None:
    """the clock locked high or back to the driver's (the gaming edition's root helper,
    scripts/gpu-clocks-setup.sh; without it nothing happens)"""
    if os.path.exists(GPU_CLOCKS):
        _run("sudo", "-n", GPU_CLOCKS, "game" if on else "reset")


def pointer_lock_wanted() -> bool:
    """angelOS's Settings → System → Games: the pointer stays on the game's screen"""
    try:
        return (json.loads(SETTINGS.read_text()).get("gaming") or {}).get("pointerLock", True) is not False
    except (OSError, ValueError, AttributeError):
        return True


def pointer_lock(on: bool, output: str | None = None) -> None:
    """angel-niri keeps the pointer on a focused fullscreen game's output, Mod lets it out (stock
    niri doesn't know the action: nothing happens)"""
    _run("niri", "msg", "action", "set-pointer-lock", "--on", "true" if on else "false",
         *(["--output", output] if output else []))


def focus_boost_wanted() -> bool:
    """angelOS's Settings → System → Power: the focused window's processes first"""
    try:
        return (json.loads(SETTINGS.read_text()).get("system") or {}).get("focusBoost", True) is not False
    except (OSError, ValueError, AttributeError):
        return True


def process_tree(root: int) -> list[int]:
    """root and every process under it (Chromium's renderers are its grandchildren)"""
    children: dict[int, list[int]] = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                ppid = int((d / "stat").read_text().rsplit(")", 1)[1].split()[1])
            except (OSError, ValueError, IndexError):
                continue
            children.setdefault(ppid, []).append(int(d.name))
    tree, todo = [], [root]
    while todo:
        pid = todo.pop()
        tree.append(pid)
        todo += children.get(pid, [])
    return tree


class FocusBoost:
    """The focused window's processes FOCUS_BOOST nice steps up; each thread gets its own nice
    back when the focus moves on (unless someone changed it meanwhile)."""

    def __init__(self) -> None:
        self.pid: int | None = None
        self.saved: dict[int, tuple[int, int]] = {}   # tid: (nice before, nice set)
        self.floor = 20 - resource.getrlimit(resource.RLIMIT_NICE)[0]

    def move(self, pid: int | None) -> None:
        if pid == self.pid:
            return
        self.restore()
        self.pid = pid
        if pid is None or pid <= 1 or not focus_boost_wanted():
            return
        for proc in process_tree(pid):
            try:
                tids = [int(t.name) for t in Path(f"/proc/{proc}/task").iterdir()]
            except OSError:
                continue
            for tid in tids:
                try:
                    before = os.getpriority(os.PRIO_PROCESS, tid)
                    new = max(before - FOCUS_BOOST, self.floor)
                    if new < before:
                        os.setpriority(os.PRIO_PROCESS, tid, new)
                        self.saved[tid] = (before, new)
                except OSError:
                    pass

    def restore(self) -> None:
        # a thread born while boosted took its creator's nice: back to what that one had
        back = {new: before for before, new in sorted(self.saved.values())}
        tids = set(self.saved)
        if self.pid is not None and back:
            for proc in process_tree(self.pid):
                try:
                    tids.update(int(t.name) for t in Path(f"/proc/{proc}/task").iterdir())
                except OSError:
                    pass
        for tid in tids:
            try:
                nice = os.getpriority(os.PRIO_PROCESS, tid)
                want = self.saved[tid][0] if tid in self.saved else back.get(nice)
                if want is not None and nice == (self.saved[tid][1] if tid in self.saved else nice):
                    os.setpriority(os.PRIO_PROCESS, tid, want)
            except OSError:
                pass
        self.saved = {}
        self.pid = None


_stretching: dict[str, subprocess.Popen] = {}


def stretch_games(windows: dict[int, dict]) -> None:
    """the helper for each such game with a window open, unless it already runs (it quits by itself
    a few seconds after the game's last window)"""
    for app_id in {w.get("app_id") for w in windows.values()} & set(STRETCH_GAMES):
        proc = _stretching.get(app_id)
        if (proc is None or proc.poll() is not None) and STRETCH.exists():
            _stretching[app_id] = subprocess.Popen([sys.executable, "-I", str(STRETCH), app_id])


def write_state(game: bool) -> None:
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_name("state.tmp")
    tmp.write_text("game\n" if game else "\n")
    tmp.replace(STATE_FILE)


def boost(on: bool, output: str | None = None) -> str:
    """Game on: performance profile, niri up, voice typing off + the game flag; off: put back
    what was."""
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    if on:
        if not BOOST_SAVED.exists():
            voxtype = _run("systemctl", "--user", "is-active", "voxtype.service") == "active"
            saved = {"profile": _run("powerprofilesctl", "get"),
                     "niri_nice": renice_niri(NIRI_NICE), "voxtype": voxtype, "background": {}}
            if voxtype:
                _run("systemctl", "--user", "stop", "voxtype.service")
        else:
            try:
                saved = json.loads(BOOST_SAVED.read_text())
            except (OSError, ValueError):
                saved = {}
            renice_niri(NIRI_NICE)
        # the esports profile hands the power profile to whoever picks the next one (angelOS)
        saved["esports"] = saved.get("esports") or esports()
        lower_background(saved.setdefault("background", {}))
        BOOST_SAVED.write_text(json.dumps(saved))
        _run("powerprofilesctl", "set", "performance")
        background_fps(background_fps_wanted(), output)
        tearing(tearing_wanted(), output)
        pointer_lock(pointer_lock_wanted(), output)
        gpu_clocks(gpu_clocks_wanted())
        GAME_FLAG.touch()
        write_state(True)
        return "boost on: performance, niri nice %d" % NIRI_NICE
    GAME_FLAG.unlink(missing_ok=True)
    write_state(False)
    background_fps(0)
    tearing(False)
    pointer_lock(False)
    gpu_clocks(False)
    try:
        saved = json.loads(BOOST_SAVED.read_text())
    except (OSError, ValueError):
        return "boost off"
    if saved.get("profile") and not saved.get("esports"):
        _run("powerprofilesctl", "set", saved["profile"])
    if isinstance(saved.get("niri_nice"), int):
        renice_niri(saved["niri_nice"])
    if saved.get("voxtype"):
        _run("systemctl", "--user", "start", "voxtype.service")
    restore_background(saved.get("background") or {})
    BOOST_SAVED.unlink(missing_ok=True)
    return f"boost off: {saved.get('profile')}"


class Hysteresis:
    """Commit a new target only after it has held for its delay."""

    def __init__(self, off_delay: float = OFF_DELAY) -> None:
        self.off_delay = off_delay
        self.applied: bool | None = None
        self.pending: bool | None = None
        self.deadline = 0.0

    def update(self, target: bool, now: float) -> bool | None:
        """Feed the current target; return a state to apply now, or None."""
        if self.applied is None:
            self.applied = target
            return target
        if target == self.applied:
            self.pending = None
        elif target != self.pending:
            self.pending = target
            self.deadline = now + (ON_DELAY if target else self.off_delay)
        return self.poll(now)

    def poll(self, now: float) -> bool | None:
        if self.pending is not None and now >= self.deadline:
            self.applied, self.pending = self.pending, None
            return self.applied
        return None

    def timeout(self, now: float) -> float | None:
        return None if self.pending is None else max(0.0, self.deadline - now)


def apply(on: bool, dry_run: bool = False) -> bool:
    """Write the config for `on` and reload niri; return False if already there."""
    text = ON if on or esports() else ECO if eco() else STILL if still() else OFF
    try:
        if CFG.read_text() == text:
            return False
    except OSError:
        pass
    if dry_run:
        return True
    CFG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CFG.with_name("game-mode.kdl.tmp")
    tmp.write_text(text)
    tmp.replace(CFG)
    subprocess.call(["niri", "msg", "action", "load-config-file"], stderr=subprocess.DEVNULL)
    return True


def commit(on: bool, state: State, dry_run: bool) -> None:
    if not apply(on, dry_run):
        return
    msg = "game mode " + ("on" if on else "off")
    hit = state.covering() if on else None
    if hit:
        win, oname = hit
        w, h = win["layout"]["window_size"]
        msg += f": {win.get('app_id')} {w}x{h} on {oname}"
    if dry_run:
        msg += " (dry run)"
    print(msg, file=sys.stderr, flush=True)


def commit_boost(on: bool, state: State, dry_run: bool) -> None:
    if dry_run:
        print(f"boost {'on' if on else 'off'} (dry run)", file=sys.stderr, flush=True)
        return
    hit = state.game() if on else None
    msg = boost(on, hit[1] if hit else None)
    if hit:
        msg += f": {hit[0].get('app_id')} on {hit[1]}"
    print(msg, file=sys.stderr, flush=True)


def watch(dry_run: bool) -> None:
    hyst = Hysteresis()
    game = Hysteresis(GAME_OFF_DELAY)
    # a crash or restart mid-game left the boost on: the first event decides again, from what was saved
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    if not dry_run and not GAME_FLAG.exists():
        write_state(False)
    # a run without --watch (a flag changed) wakes this one up through the pipe
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.set_wakeup_fd(wake_w)
    signal.signal(signal.SIGUSR1, lambda *_: None)
    if not dry_run:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        WATCH_PID.write_text(str(os.getpid()))
    focus = FocusBoost()
    try:
        _watch(hyst, game, dry_run, wake_r, focus)
    finally:
        focus.restore()
        if not dry_run and (GAME_FLAG.exists() or BOOST_SAVED.exists()):
            print(boost(False), file=sys.stderr, flush=True)


def _watch(hyst: Hysteresis, game: Hysteresis, dry_run: bool, wake: int, focus: FocusBoost) -> None:
    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["niri", "msg", "--json", "event-stream"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
            assert proc.stdout is not None
            fd = proc.stdout.fileno()
            state = State()
            buf = b""
            while True:
                waits = [t for t in (hyst.timeout(time.monotonic()), game.timeout(time.monotonic())) if t is not None]
                ready, _, _ = select.select([fd, wake], [], [], min(waits) if waits else None)
                if wake in ready:
                    os.read(wake, 64)
                    if state.ready:
                        now = time.monotonic()
                        hyst.update(state.covering() is not None or esports(), now)
                        game.update(state.game() is not None or esports(), now)
                        # the esports profile left: no alt-tab to wait out
                        if game.pending is False and state.game() is None:
                            game.deadline = now
                    result = hyst.poll(time.monotonic())
                    boosted = game.poll(time.monotonic())
                elif ready:
                    chunk = os.read(fd, 1 << 16)
                    if not chunk:
                        break
                    buf += chunk
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        if line.strip():
                            state.feed(line)
                    if not state.ready:
                        continue
                    if not dry_run:
                        win = next((w for w in state.windows.values() if w.get("is_focused")), None)
                        focus.move(win.get("pid") if win else None)
                        stretch_games(state.windows)
                    now = time.monotonic()
                    result = hyst.update(state.covering() is not None or esports(), now)
                    boosted = game.update(state.game() is not None or esports(), now)
                else:
                    result = hyst.poll(time.monotonic())
                    boosted = game.poll(time.monotonic())
                if result is not None:
                    commit(result, state, dry_run)
                if boosted is not None and (boosted or GAME_FLAG.exists() or BOOST_SAVED.exists()):
                    commit_boost(boosted, state, dry_run)
        except Exception as e:
            print(f"niri-game-mode: {e!r}", file=sys.stderr, flush=True)
        finally:
            if proc is not None:
                proc.kill()
                proc.wait()
        time.sleep(1.5)


def main() -> None:
    dry_run = "--dry-run" in sys.argv
    if "--watch" in sys.argv:
        watch(dry_run)
        return
    state = State()
    try:
        state.load_snapshot()
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        pass
    on = state.covering() is not None
    commit(on, state, dry_run)
    # only the watcher itself: SIGUSR1 kills a process that does not expect it
    try:
        pid = int(WATCH_PID.read_text())
        if b"niri-game-mode\0--watch" in Path(f"/proc/{pid}/cmdline").read_bytes():
            os.kill(pid, signal.SIGUSR1)
    except (OSError, ValueError):
        pass
    print("on" if on else "off")


if __name__ == "__main__":
    main()
