#!/usr/bin/env python3
"""Disable niri animations and compositor effects while a window covers an output.

angelOS's Settings → Appearance → Motion "off" (settings.json appearance.motion) keeps niri's
animations off all the time, effects untouched; angelOS runs this once when it changes.

While the covering window is a game (--watch only), also boost: the "performance" power
profile (no password: power-profiles-daemon allows the active session; sched-ext is left
alone, scx_loader asks for one) and $XDG_RUNTIME_DIR/niri-game-mode/game for anyone who
should step aside (the stream bot unloads its whisper from the video card). All of it goes
back to what it was when the game leaves fullscreen or this exits."""
from __future__ import annotations

import json
import os
import re
import select
import signal
import subprocess
import sys
import time
from pathlib import Path

CFG = Path.home() / ".config/niri/cfg/game-mode.kdl"
SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "angelos/settings.json"
RUN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "niri-game-mode"
GAME_FLAG = RUN_DIR / "game"
BOOST_SAVED = RUN_DIR / "boost.json"

ON = """\
// auto-generated by niri-game-mode — fullscreen: effects off
animations {
    off
}

window-rule {
    opacity 1.0
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry false
}

window-rule {
    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-"
    match namespace="^angelos-"
    background-effect {
        blur false
        xray false
    }
}
"""

OFF = """\
// auto-generated by niri-game-mode — inactive
"""

STILL = """\
// auto-generated by niri-game-mode — angelOS motion off: no animations
animations {
    off
}
"""


def still() -> bool:
    """angelOS's motion setting is "off" (no animations, an optimisation mode)"""
    try:
        return (json.loads(SETTINGS.read_text()).get("appearance") or {}).get("motion") == "off"
    except (OSError, ValueError, AttributeError):
        return False

# A new state must hold this long before the config is reloaded, so a window
# passing through output size (launch, fullscreen toggle, alt-tab) costs one
# reload instead of a burst of them.
ON_DELAY = 0.3
OFF_DELAY = 0.6
SIZE_SLACK = 2


def niri_json(*args):
    raw = subprocess.check_output(["niri", "msg", "--json", *args], stderr=subprocess.DEVNULL)
    return json.loads(raw)


def output_sizes() -> dict[str, tuple[int, int]]:
    try:
        outputs = niri_json("outputs") or {}
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        return {}
    sizes = {}
    for name, o in outputs.items():
        logical = o.get("logical") or {}
        try:
            sizes[name] = (int(logical["width"]), int(logical["height"]))
        except (KeyError, TypeError, ValueError):
            continue
    return sizes


class State:
    """Windows and workspaces, kept current from niri's event stream."""

    def __init__(self) -> None:
        self.sizes = output_sizes()
        self.workspaces: dict[int, dict] | None = None
        self.windows: dict[int, dict] | None = None

    @property
    def ready(self) -> bool:
        return self.workspaces is not None and self.windows is not None

    def feed(self, line: bytes) -> None:
        try:
            ev = json.loads(line)
            if isinstance(ev, dict) and len(ev) == 1:
                (key, body), = ev.items()
                self.handle(key, body)
        except (json.JSONDecodeError, KeyError, TypeError, ValueError, AttributeError):
            pass

    def handle(self, key: str, body: dict) -> None:
        if key == "WorkspacesChanged":
            self.workspaces = {ws["id"]: ws for ws in body["workspaces"]}
            # A new output (hotplug) shows up here first.
            if any(ws.get("output") and ws["output"] not in self.sizes
                   for ws in self.workspaces.values()):
                self.sizes = output_sizes()
        elif key == "WorkspaceActivated" and self.workspaces is not None:
            ws = self.workspaces.get(body["id"])
            if ws is not None:
                for other in self.workspaces.values():
                    if other.get("output") == ws.get("output"):
                        other["is_active"] = False
                ws["is_active"] = True
        elif key == "WindowsChanged":
            self.windows = {w["id"]: w for w in body["windows"]}
        elif key == "WindowOpenedOrChanged" and self.windows is not None:
            self.windows[body["window"]["id"]] = body["window"]
        elif key == "WindowClosed" and self.windows is not None:
            self.windows.pop(body["id"], None)
        elif key == "WindowLayoutsChanged" and self.windows is not None:
            for wid, layout in body["changes"]:
                if wid in self.windows:
                    self.windows[wid]["layout"] = layout
        elif key == "ConfigLoaded":
            # Mode, scale or transform may have changed.
            self.sizes = output_sizes()

    def load_snapshot(self) -> None:
        self.handle("WorkspacesChanged", {"workspaces": niri_json("workspaces") or []})
        self.handle("WindowsChanged", {"windows": niri_json("windows") or []})

    def covering(self) -> tuple[dict, str | None] | None:
        """Return (window, output) for a window that covers its output, if any."""
        return next(self.coverers(), None)

    def game(self) -> tuple[dict, str | None] | None:
        """Return (window, output) for a game that covers its output, if any."""
        return next((hit for hit in self.coverers() if is_game(hit[0])), None)

    def coverers(self):
        if not self.ready:
            return
        active = {ws["id"]: ws.get("output")
                  for ws in self.workspaces.values() if ws.get("is_active")}
        for win in self.windows.values():
            wid = win.get("workspace_id")
            if wid not in active:
                continue
            size = (win.get("layout") or {}).get("window_size") or [0, 0]
            try:
                ww, hh = int(size[0]), int(size[1])
            except (TypeError, ValueError, IndexError):
                continue
            oname = active[wid]
            candidates = [self.sizes[oname]] if oname in self.sizes else list(self.sizes.values())
            for ow, oh in candidates:
                if abs(ww - ow) <= SIZE_SLACK and abs(hh - oh) <= SIZE_SLACK:
                    yield win, oname
                    break


def _environ(pid: int) -> bytes:
    try:
        return Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return b""


def _comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def steam_game_running() -> bool:
    """Steam's reaper (`reaper SteamLaunch AppId=… -- game`) lives as long as the game."""
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if b"SteamLaunch" in (d / "cmdline").read_bytes():
                    return True
            except OSError:
                pass
    return False


def is_game(win: dict) -> bool:
    """Proton games show up as steam_app_<id>; native ones carry Steam's SteamGameId; X11 ones
    reach niri through xwayland-satellite, so for those a running Steam game has to do."""
    app_id = win.get("app_id") or ""
    if app_id.startswith("steam_app_") or app_id == "gamescope":
        return True
    pid = win.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return False
    env = _environ(pid)
    if re.search(rb"(?:^|\0)Steam(?:Game|App)Id=[1-9]", env):
        return True
    return _comm(pid).lower().startswith(("xwayland", "xwayland-satellite")) and steam_game_running()


def _run(*cmd: str) -> str | None:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10, check=True).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None


def boost(on: bool) -> str:
    """Game on: performance profile + the game flag; off: put back the profile that was."""
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    if on:
        if not BOOST_SAVED.exists():
            BOOST_SAVED.write_text(json.dumps({"profile": _run("powerprofilesctl", "get")}))
        _run("powerprofilesctl", "set", "performance")
        GAME_FLAG.touch()
        return "boost on: performance"
    GAME_FLAG.unlink(missing_ok=True)
    try:
        saved = json.loads(BOOST_SAVED.read_text())
    except (OSError, ValueError):
        return "boost off"
    if saved.get("profile"):
        _run("powerprofilesctl", "set", saved["profile"])
    BOOST_SAVED.unlink(missing_ok=True)
    return f"boost off: {saved.get('profile')}"


class Hysteresis:
    """Commit a new target only after it has held for its delay."""

    def __init__(self) -> None:
        self.applied: bool | None = None
        self.pending: bool | None = None
        self.deadline = 0.0

    def update(self, target: bool, now: float) -> bool | None:
        """Feed the current target; return a state to apply now, or None."""
        if self.applied is None:
            self.applied = target
            return target
        if target == self.applied:
            self.pending = None
        elif target != self.pending:
            self.pending = target
            self.deadline = now + (ON_DELAY if target else OFF_DELAY)
        return self.poll(now)

    def poll(self, now: float) -> bool | None:
        if self.pending is not None and now >= self.deadline:
            self.applied, self.pending = self.pending, None
            return self.applied
        return None

    def timeout(self, now: float) -> float | None:
        return None if self.pending is None else max(0.0, self.deadline - now)


def apply(on: bool, dry_run: bool = False) -> bool:
    """Write the config for `on` and reload niri; return False if already there."""
    text = ON if on else STILL if still() else OFF
    try:
        if CFG.read_text() == text:
            return False
    except OSError:
        pass
    if dry_run:
        return True
    CFG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CFG.with_name("game-mode.kdl.tmp")
    tmp.write_text(text)
    tmp.replace(CFG)
    subprocess.call(["niri", "msg", "action", "load-config-file"], stderr=subprocess.DEVNULL)
    return True


def commit(on: bool, state: State, dry_run: bool) -> None:
    if not apply(on, dry_run):
        return
    msg = "game mode " + ("on" if on else "off")
    hit = state.covering() if on else None
    if hit:
        win, oname = hit
        w, h = win["layout"]["window_size"]
        msg += f": {win.get('app_id')} {w}x{h} on {oname}"
    if dry_run:
        msg += " (dry run)"
    print(msg, file=sys.stderr, flush=True)


def commit_boost(on: bool, state: State, dry_run: bool) -> None:
    if dry_run:
        print(f"boost {'on' if on else 'off'} (dry run)", file=sys.stderr, flush=True)
        return
    msg = boost(on)
    hit = state.game() if on else None
    if hit:
        msg += f": {hit[0].get('app_id')} on {hit[1]}"
    print(msg, file=sys.stderr, flush=True)


def watch(dry_run: bool) -> None:
    hyst = Hysteresis()
    game = Hysteresis()
    # a crash or restart mid-game left the boost on: the first event decides again, from what was saved
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        _watch(hyst, game, dry_run)
    finally:
        if not dry_run and (GAME_FLAG.exists() or BOOST_SAVED.exists()):
            print(boost(False), file=sys.stderr, flush=True)


def _watch(hyst: Hysteresis, game: Hysteresis, dry_run: bool) -> None:
    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["niri", "msg", "--json", "event-stream"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
            assert proc.stdout is not None
            fd = proc.stdout.fileno()
            state = State()
            buf = b""
            while True:
                waits = [t for t in (hyst.timeout(time.monotonic()), game.timeout(time.monotonic())) if t is not None]
                ready, _, _ = select.select([fd], [], [], min(waits) if waits else None)
                if ready:
                    chunk = os.read(fd, 1 << 16)
                    if not chunk:
                        break
                    buf += chunk
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        if line.strip():
                            state.feed(line)
                    if not state.ready:
                        continue
                    now = time.monotonic()
                    result = hyst.update(state.covering() is not None, now)
                    boosted = game.update(state.game() is not None, now)
                else:
                    result = hyst.poll(time.monotonic())
                    boosted = game.poll(time.monotonic())
                if result is not None:
                    commit(result, state, dry_run)
                if boosted is not None and (boosted or GAME_FLAG.exists() or BOOST_SAVED.exists()):
                    commit_boost(boosted, state, dry_run)
        except Exception as e:
            print(f"niri-game-mode: {e!r}", file=sys.stderr, flush=True)
        finally:
            if proc is not None:
                proc.kill()
                proc.wait()
        time.sleep(1.5)


def main() -> None:
    dry_run = "--dry-run" in sys.argv
    if "--watch" in sys.argv:
        watch(dry_run)
        return
    state = State()
    try:
        state.load_snapshot()
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        pass
    on = state.covering() is not None
    commit(on, state, dry_run)
    print("on" if on else "off")


if __name__ == "__main__":
    main()
