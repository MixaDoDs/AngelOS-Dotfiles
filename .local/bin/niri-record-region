#!/usr/bin/env bash
set -euo pipefail

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.pid"
OVERLAY_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/niri-record-overlay.pid"
OUTFILE_META="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.out"
# pause = the recorder stops, resume = a new piece; the pieces are glued on stop (wf-recorder
# has no pause of its own). GEOM: the region; PARTS: the pieces, one a line; PAUSED: there
# while paused; ACC: ms recorded before the running piece (the shell's clock)
GEOM="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.geom"
PARTS="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.parts"
PAUSED="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.paused"
ACC="${XDG_RUNTIME_DIR:-/tmp}/niri-record-region.acc"
OVERLAY_BIN="${HOME}/.local/bin/niri-record-overlay"
SELECTOR="${HOME}/.local/bin/niri-screenshot-region"
# --stop: only stop a recording that runs (the Halo's stop button), never open the selector;
# --pause: pause a running one, or go on with a paused one (the Halo)
STOP_ONLY=0; [[ "${1:-}" == --stop ]] && STOP_ONLY=1
PAUSE=0; [[ "${1:-}" == --pause ]] && PAUSE=1
# angelOS Settings → System → Screenshots and recording (settings.json "capture"):
# folder, frame rate, sound, codec — one line each
mapfile -t CAP < <(python3 - <<'PY' 2>/dev/null
import json, os
base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
try:
    c = json.load(open(os.path.join(base, "angelos/settings.json"))).get("capture") or {}
except Exception:
    c = {}
print(os.path.expanduser(c.get("recordDir") or "~/Videos"))
print(int(c.get("recordFps") or 60))
print(c.get("recordAudio") or "none")
print(c.get("recordCodec") or "auto")
PY
)
OUTDIR="${CAP[0]:-${HOME}/Videos}"
FPS="${NIRI_RECORD_FPS:-${CAP[1]:-60}}"
AUDIO="${CAP[2]:-none}"
CODEC="${CAP[3]:-auto}"
if [[ "$CODEC" == auto ]]; then
  if [[ -e /proc/driver/nvidia/version ]]; then CODEC=nvenc
  elif compgen -G "/dev/dri/renderD*" >/dev/null; then CODEC=vaapi
  else CODEC=x264; fi
fi
case "$CODEC" in
  # no GOP of its own: with these settings NVENC wrote one keyframe for the whole file and
  # every seek decoded from the start (#73): one a second
  # H.264, not HEVC: browsers on Linux and GitHub don't play HEVC (a white frame), and a
  # recording is mostly made to show someone (#86)
  nvenc) ENC=(-c h264_nvenc -p cq=23 -p preset=p4 -p tune=ll -p g="$FPS" -b 0); CODEC_LABEL="H.264 NVENC" ;;
  vaapi) ENC=(-c h264_vaapi -d "$(compgen -G '/dev/dri/renderD*' | head -n1)"); CODEC_LABEL="H.264 VA-API" ;;
  *) ENC=(-c libx264 -p crf=23 -p preset=veryfast); CODEC_LABEL="x264" ;;
esac
# the sound: what you hear (the default output's monitor), the microphone, or both (wf-recorder
# takes one device: "both" records what you hear)
AUD=()
case "$AUDIO" in
  system|both) mon="$(pactl get-default-sink 2>/dev/null).monitor"; AUD=(--audio="$mon") ;;
  mic) src="$(pactl get-default-source 2>/dev/null)"; AUD=(--audio="$src") ;;
esac
mkdir -p "$OUTDIR"

notify() {
  notify-send -a "Screen record" "$@" || true
}

stop_overlay() {
  if [[ -f "$OVERLAY_PIDFILE" ]]; then
    opid=$(<"$OVERLAY_PIDFILE")
    kill "$opid" 2>/dev/null || true
    rm -f "$OVERLAY_PIDFILE"
  fi
  pkill -f 'python3 .*/niri-record-overlay' 2>/dev/null || true
  pkill -f '/niri-record-overlay ' 2>/dev/null || true
}

# angelOS re-reads the pid file (services/Capture: the Halo's record capsule); recSaved puts the
# finished file on the Halo's shelf
tell_shell() {
  (qs -c angelos ipc call angelos recChanged >/dev/null 2>&1 &) || true
}
tell_saved() {
  (qs -c angelos ipc call angelos recSaved "$1" >/dev/null 2>&1 &) || true
}

running() { [[ -f "$PIDFILE" ]] && kill -0 "$(<"$PIDFILE")" 2>/dev/null; }

# the running piece ends; its time goes into ACC
end_piece() {
  local pid; pid=$(<"$PIDFILE")
  local began; began=$(stat -c %Y "$PIDFILE")
  kill -INT "$pid" 2>/dev/null || true
  for _ in $(seq 1 100); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PIDFILE"
  local acc=0; [[ -f "$ACC" ]] && acc=$(<"$ACC")
  echo $((acc + ($(date +%s) - began) * 1000)) >"$ACC"
}

start_piece() {
  local file="$1"
  wf-recorder -g "$(<"$GEOM")" -f "$file" -r "$FPS" -D "${ENC[@]}" "${AUD[@]}" \
    >>/tmp/niri-record-region.log 2>&1 &
  echo $! >"$PIDFILE"
  disown || true
  echo "$file" >>"$PARTS"
}

if [[ $PAUSE == 1 ]]; then
  if [[ -f "$PAUSED" ]]; then
    outfile=$(<"$OUTFILE_META")
    n=$(($(wc -l <"$PARTS") + 1))
    rm -f "$PAUSED"
    start_piece "$(dirname "$outfile")/.$(basename "${outfile%.mp4}")-$n.mp4"
  elif running; then
    end_piece
    touch "$PAUSED"
  fi
  tell_shell
  exit 0
fi

if running || [[ -f "$PAUSED" ]]; then
  outfile=""
  [[ -f "$OUTFILE_META" ]] && outfile=$(<"$OUTFILE_META")
  running && end_piece
  stop_overlay
  # more than one piece (it was paused): glued into the first, without re-encoding
  if [[ -f "$PARTS" && $(wc -l <"$PARTS") -gt 1 ]]; then
    list=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/niri-record-concat.XXXXXX")
    # shortcut: a ' in the folder's path breaks the list; quote it if anyone records there
    while IFS= read -r f; do if [[ -s "$f" ]]; then printf "file '%s'\n" "$f"; fi; done <"$PARTS" >"$list"
    glued="$(dirname "$outfile")/.$(basename "${outfile%.mp4}")-all.mp4"
    if ffmpeg -nostdin -loglevel error -y -f concat -safe 0 -i "$list" -c copy "$glued" >>/tmp/niri-record-region.log 2>&1; then
      mv -f "$glued" "$outfile"
      tail -n +2 "$PARTS" | while IFS= read -r f; do rm -f "$f"; done
    else
      rm -f "$glued"
      notify "Куски записи не склеились" "они лежат рядом: $(dirname "$outfile")"
    fi
    rm -f "$list"
  fi
  rm -f "$PAUSED" "$PARTS" "$ACC" "$GEOM"
  tell_shell
  if [[ -n "$outfile" && -f "$outfile" ]]; then
    tell_saved "$outfile"
    notify "Сохранено (${FPS} fps)" "$outfile"
  else
    notify "Запись остановлена" "смотри /tmp/niri-record-region.log"
  fi
  exit 0
fi
if [[ -f "$PIDFILE" ]]; then
  rm -f "$PIDFILE"
  stop_overlay
  tell_shell
fi
[[ $STOP_ONLY == 1 ]] && exit 0

command -v wf-recorder >/dev/null 2>&1 || {
  notify "Нет wf-recorder" "sudo pacman -S wf-recorder"
  exit 1
}

# same rope UI as screenshots
geom=$("$SELECTOR" --geometry) || exit 0
[[ -n "$geom" ]] || exit 0

stamp=$(date +%Y%m%d-%H%M%S)
outfile="${OUTDIR}/niri-${stamp}.mp4"
printf '%s\n' "$outfile" >"$OUTFILE_META"

stop_overlay
if [[ -x "$OVERLAY_BIN" ]]; then
  "$OVERLAY_BIN" "$geom" >/tmp/niri-record-overlay.spawn.log 2>&1 &
  echo $! >"$OVERLAY_PIDFILE"
  disown || true
  sleep 0.05
fi

printf '%s\n' "$geom" >"$GEOM"
rm -f "$PARTS" "$PAUSED" "$ACC"
: >/tmp/niri-record-region.log
start_piece "$outfile"
tell_shell

notify "Запись ${FPS} fps · ${CODEC_LABEL}" "Meta+Shift+R — стоп · ${outfile##*/}"
